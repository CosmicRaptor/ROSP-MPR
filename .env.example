# Copy to backend/.env  (cp .env.example backend/.env) and edit. Never commit the real .env.

# --- OpenAlex (research metadata) -------------------------------------------
# No key needed. Adding your email puts you in OpenAlex's faster "polite pool".
OPENALEX_EMAIL=
# Optional, only if you have an OpenAlex API key.
OPENALEX_API_KEY=

# --- Summarizer (local LLM via Ollama) ---------------------------------------
# auto   = use Ollama if it is running and the model is pulled, otherwise the demo summarizer
# mock   = always use the offline demo summarizer
# ollama = always use Ollama (errors fall back to the demo summarizer)
SUMMARIZER=auto
# Default chosen for a 24 GB M4 MacBook Air: ~5 GB, ~10-15 s per paper. Upgrade option: qwen3:14b (~9 GB, slower).
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# --- Development helpers -----------------------------------------------------
# true = skip OpenAlex and use the small offline demo dataset (good for presentations without Wi-Fi)
USE_DEMO_DATA=false
# Comma-separated frontend origins allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
